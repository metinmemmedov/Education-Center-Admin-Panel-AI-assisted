@model IEnumerable<Enrollment>
@{ ViewData["Title"] = "Enrollments"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h2 class="m-0">Enrollments</h2><span class="meta">@Model.Count() enrollments</span></div>
  <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Enroll student</a>
</div>
<div class="panel p-0 overflow-hidden"><div class="table-responsive">
<table class="table table-modern table-hover">
  <thead><tr><th class="ps-4">Student</th><th>Course</th><th>Date</th><th>Grade</th><th></th></tr></thead>
  <tbody>
  @foreach (var e in Model)
  {
    <tr>
      <td class="ps-4"><div class="d-flex align-items-center gap-2">
        <span class="avatar" style="background:@CourseStyle.AvatarColor(e.Student?.FullName);width:34px;height:34px;font-size:.8rem">@CourseStyle.Initials(e.Student?.FullName)</span>
        @e.Student?.FullName</div></td>
      <td><i class="bi @CourseStyle.Icon(e.Course?.Category)" style="color:@CourseStyle.Color(e.Course?.Category)"></i> @e.Course?.Title</td>
      <td class="meta">@e.EnrolledOn.ToString("dd MMM yyyy")</td>
      <td>
        <form asp-action="SetGrade" asp-route-id="@e.Id" method="post" class="d-flex gap-1">
          <input name="grade" value="@e.Grade" class="form-control form-control-sm" style="width:75px" maxlength="5" placeholder="-" />
          <button class="btn btn-soft btn-sm"><i class="bi bi-check2"></i></button>
        </form>
      </td>
      <td class="text-end pe-3">
        <form asp-action="Delete" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Remove enrollment?');">
          <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table></div></div>
