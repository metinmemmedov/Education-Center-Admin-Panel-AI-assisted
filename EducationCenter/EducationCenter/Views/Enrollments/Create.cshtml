@model Enrollment
@{ ViewData["Title"] = "Enroll student"; }
<h2 class="mb-3">Enroll a student</h2>
<div class="panel col-lg-6">
<form method="post">
  <div asp-validation-summary="All" class="text-danger"></div>
  <div class="mb-3"><label class="form-label">Student</label><select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"></select></div>
  <div class="mb-3"><label class="form-label">Course</label><select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"></select></div>
  <button class="btn btn-primary px-4">Enroll</button>
  <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
</div>
