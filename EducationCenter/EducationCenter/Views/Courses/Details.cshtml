@model Course
@{
    ViewData["Title"] = Model.Title;
    var color = CourseStyle.Color(Model.Category);
    var left = Model.Capacity - Model.Enrollments.Count;
}
<a asp-action="Index" class="meta"><i class="bi bi-arrow-left"></i> Back to courses</a>
<div class="course-card mt-2 mb-4">
  <div class="course-banner" style="background:@color;height:170px;font-size:4.5rem">
    <span class="level-badge">@Model.Level</span>
    <span class="status-badge" style="background:@CourseStyle.StatusClass(Model.Status)">@Model.Status</span>
    <i class="bi @CourseStyle.Icon(Model.Category)"></i>
  </div>
  <div class="p-4">
    <div class="meta" style="color:@color;font-weight:600">@Model.Category</div>
    <h2>@Model.Title</h2>
    <p class="meta"><i class="bi bi-person"></i> Taught by <strong>@Model.Instructor</strong> · added @Model.CreatedAt.ToString("dd MMM yyyy")</p>
    <p>@Model.Description</p>
    <div class="row g-3 my-2">
      <div class="col-6 col-md-3"><div class="panel text-center"><div class="price-tag">@Model.Price.ToString("C0")</div><span class="meta">Price</span></div></div>
      <div class="col-6 col-md-3"><div class="panel text-center"><strong>@Model.StartDate.ToString("dd MMM yyyy")</strong><br /><span class="meta">Start date</span></div></div>
      <div class="col-6 col-md-3"><div class="panel text-center"><strong>@Model.Capacity</strong><br /><span class="meta">Total seats</span></div></div>
      <div class="col-6 col-md-3"><div class="panel text-center"><strong class="@(left > 0 ? "text-success" : "text-danger")">@(left > 0 ? left + " left" : "Full")</strong><br /><span class="meta">Availability</span></div></div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
      <a class="btn btn-primary" asp-controller="Enrollments" asp-action="Create" asp-route-courseId="@Model.Id"><i class="bi bi-person-plus"></i> Enroll a student</a>
      <a class="btn btn-soft" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
      <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="bi bi-trash"></i> Delete</a>
      <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 ms-lg-auto">
        <select name="status" asp-items="@(new SelectList(CourseStyle.Statuses, Model.Status))" class="form-select w-auto"></select>
        <button class="btn btn-soft">Change status</button>
      </form>
    </div>
  </div>
</div>

<div class="panel">
  <h5 class="mb-3">Enrolled students (@Model.Enrollments.Count)</h5>
  @foreach (var e in Model.Enrollments.OrderBy(x => x.Student!.FullName))
  {
    <div class="d-flex align-items-center gap-3 py-2 border-bottom">
      <span class="avatar" style="background:@CourseStyle.AvatarColor(e.Student?.FullName)">@CourseStyle.Initials(e.Student?.FullName)</span>
      <a asp-controller="Students" asp-action="Details" asp-route-id="@e.StudentId">@e.Student?.FullName</a>
      @if (!string.IsNullOrEmpty(e.Grade)) { <span class="grade ms-auto">@e.Grade</span> }
    </div>
  }
  @if (!Model.Enrollments.Any()) { <p class="meta m-0">No students enrolled yet.</p> }
</div>
