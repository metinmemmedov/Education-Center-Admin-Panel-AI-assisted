@model IEnumerable<Course>
@{
    ViewData["Title"] = "Courses";
    int page = ViewBag.Page; int pages = ViewBag.Pages;
    string? cat = ViewBag.Category;
}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h2 class="m-0">Courses</h2><span class="meta">Total: <strong>@ViewBag.Total</strong> courses</span></div>
  <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New course</a>
</div>

<div class="panel mb-3">
  <form class="row g-2" method="get">
    <input type="hidden" name="category" value="@cat" />
    <div class="col-lg-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by title or instructor" /></div>
    <div class="col-lg-3">
      <select name="status" class="form-select">
        <option value="">All statuses</option>
        @foreach (var st in CourseStyle.Statuses)
        {
          <option value="@st" selected="@(ViewBag.Status == st)">@st</option>
        }
      </select>
    </div>
    <div class="col-lg-2">
      <select name="sort" class="form-select">
        <option value="">Sort: Title</option>
        <option value="price" selected="@(ViewBag.Sort == "price")">Price</option>
        <option value="date" selected="@(ViewBag.Sort == "date")">Start date</option>
        <option value="newest" selected="@(ViewBag.Sort == "newest")">Newest added</option>
      </select>
    </div>
    <div class="col-lg-2 d-grid"><button class="btn btn-primary"><i class="bi bi-search"></i> Apply</button></div>
  </form>
</div>

<div class="mb-2">
  <a class="pill @(string.IsNullOrEmpty(cat) ? "active" : "")" asp-action="Index">All</a>
  @foreach (var c in CourseStyle.Categories)
  {
    <a class="pill @(cat == c ? "active" : "")" asp-action="Index" asp-route-category="@c"><i class="bi @CourseStyle.Icon(c)"></i> @c</a>
  }
</div>

<div class="row g-4">
@foreach (var c in Model)
{
  <div class="col-md-6 col-lg-4 d-flex flex-column">
    <div class="flex-grow-1 d-flex flex-column">
      <partial name="_CourseCard" model="c" />
    </div>
    <div class="d-flex gap-2 mt-2 justify-content-end">
      <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> Edit</a>
      <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@c.Id"><i class="bi bi-trash"></i> Delete</a>
    </div>
  </div>
}
</div>
@if (!Model.Any())
{
  <div class="panel text-center py-5"><i class="bi bi-emoji-frown fs-1 text-muted"></i><p class="meta m-0">No courses found.</p></div>
}
@if (pages > 1)
{
  <nav class="mt-4"><ul class="pagination justify-content-center">
  @for (int i = 1; i <= pages; i++)
  {
    <li class="page-item @(i == page ? "active" : "")">
      <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort" asp-route-category="@cat" asp-route-status="@ViewBag.Status">@i</a>
    </li>
  }
  </ul></nav>
}
