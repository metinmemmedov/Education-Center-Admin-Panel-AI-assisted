@model Course
@{ ViewData["Title"] = "Delete course"; }
<h2 class="mb-3">Delete course</h2>
<div class="alert alert-warning border-0 rounded-4"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this course?
  @if (Model.Enrollments.Count > 0) { <strong> @Model.Enrollments.Count enrollment(s) will also be removed.</strong> }
</div>
<div class="panel col-lg-7 mb-3">
  <h4>@Model.Title</h4>
  <p class="meta">@Model.Category · @Model.Level · @Model.Instructor</p>
  <p>@Model.Description</p>
</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
  <button type="submit" class="btn btn-danger px-4">Yes, delete</button>
  <a asp-action="Index" class="btn btn-secondary">No</a>
</form>
