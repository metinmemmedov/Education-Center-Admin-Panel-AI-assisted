@model Student
@{ ViewData["Title"] = "Delete student"; }
<h2 class="mb-3">Delete student</h2>
<div class="alert alert-warning border-0 rounded-4"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this student?
  @if (Model.Enrollments.Count > 0) { <strong> @Model.Enrollments.Count enrollment(s) will also be removed.</strong> }
</div>
<div class="panel col-lg-6 mb-3 d-flex align-items-center gap-3">
  <span class="avatar avatar-lg" style="background:@CourseStyle.AvatarColor(Model.FullName)">@CourseStyle.Initials(Model.FullName)</span>
  <div><h4 class="m-0">@Model.FullName</h4><span class="meta">@Model.Email</span></div>
</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
  <button type="submit" class="btn btn-danger px-4">Yes, delete</button>
  <a asp-action="Index" class="btn btn-secondary">No</a>
</form>
